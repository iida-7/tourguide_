# Vercel CLI 직접 배포(vercel / vercel --prod) 때 업로드하지 않을 파일.
# .vercelignore가 있으면 CLI는 .gitignore 대신 이 파일을 기준으로 삼으므로 .gitignore의 항목도 여기에 다시 적는다.

# 비밀값 (Gemini 키는 Vercel 환경변수로 따로 등록)
.env
.env.local
.env.*
!.env.example

# 개인 입력 데이터
DOCS/원문*.txt

# 로컬 진단 스크립트 (앱 동작과 무관)
scripts/

# 빌드 산출물·의존성 (Vercel이 서버에서 새로 설치·빌드)
node_modules
.next
.vercel
